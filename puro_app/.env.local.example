# Required. MongoDB connection string.
# Development example: mongodb://localhost:27017/supplier-payments
# Configure the real Atlas value only in .env.local or the Netlify environment.
MONGODB_URI=

# Required. Strong random secret used to sign and verify authentication tokens.
# Use a different value in every environment; never commit it.
JWT_SECRET=

# NODE_ENV is managed automatically by Next.js and Netlify.
